{
  "name": "iblaime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IBLAIME — juego voxel estilizado, Android como plataforma prioritaria.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
