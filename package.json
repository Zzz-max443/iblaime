    "verify": "tsx tests/smoke.ts"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "@types/three": "^0.169.0",
    "tsx": "^4.19.0"
  }
}
